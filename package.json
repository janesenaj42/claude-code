{
  "name": "project-baseline",
  "private": true,
  "type": "module",
  "description": "Repo-wide tooling only (git hooks, commit and branch checks). Each stack keeps its own toolchain.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "commit": "cz",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.17"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
