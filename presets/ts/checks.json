{
  "name": "typescript",
  "root": ".",
  "onEdit": [
    { "run": ["npx", "--no", "--", "prettier", "--write", "--ignore-unknown", "{file}"] },
    { "match": "\\.(ts|tsx|js|jsx|mjs|cjs)$", "run": ["npx", "--no", "--", "eslint", "{file}"] }
  ],
  "onStop": [
    { "run": ["npm", "run", "typecheck"] },
    { "run": ["npm", "test"] }
  ]
}
